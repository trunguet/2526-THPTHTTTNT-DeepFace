# Shared deployment template.
# Copy this file to .env on every machine and fill the same shared service values.
# Do not commit real credentials.

# 1) Shared MySQL: all machines must use this exact same DATABASE_URL.
# For MySQL on the Windows host of each local machine, use host.docker.internal.
# For a real shared server/cloud DB, use its public/private host.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DB_Employee?charset=utf8mb4
DATABASE_SSL=false
MYSQL_DATABASE=DB_Employee
TIDB_DATABASE=DB_Employee

# 2) Shared object storage is recommended.
# If every machine keeps MinIO local, employee rows are shared in MySQL but images
# saved by one machine will not exist on the other machines.
MINIO_ENDPOINT=HOST:PORT
MINIO_ACCESS_KEY=USER
MINIO_SECRET_KEY=PASSWORD
MINIO_BUCKET=deepface-media

# 3) Shared Qdrant is recommended for identical recognition behavior.
# If Qdrant is local per machine, run /api/employees/reindex-all after syncing
# employees/images so each machine rebuilds its vectors.
QDRANT_URL=http://HOST:6333
QDRANT_COLLECTION=face_embeddings

# 4) Redis can remain local for cache/queue, but a shared Redis can be used if
# backend and worker are intentionally split across machines.
REDIS_URL=redis://redis:6379/0

GATEWAY_PORT=8080
PUBLIC_API_BASE_URL=http://localhost:8080
ADMIN_AUTH_SECRET=change-this-to-the-same-secret-on-every-machine
