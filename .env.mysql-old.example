# Copy these values into .env when you want the app to use the existing
# MySQL database opened in MySQL Workbench instead of the local Docker MySQL.
#
# Do not commit the real .env file.

# Case 1: MySQL is installed/running directly on this Windows machine.
# Containers reach the Windows host through host.docker.internal.
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@host.docker.internal:3306/DB_Employee?charset=utf8mb4
# DATABASE_SSL=false

# Case 2: MySQL/TiDB Cloud or another remote MySQL server.
# Use the exact host, port, username, password, and database from Workbench.
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DB_Employee?charset=utf8mb4
# DATABASE_SSL=true

# Keep this database name aligned with Workbench.
MYSQL_DATABASE=DB_Employee
TIDB_DATABASE=DB_Employee

# If the existing rows reference images in an existing MinIO/S3 bucket, point
# these values to that same object store. Otherwise employee rows will show,
# but old image URLs may not load.
# MINIO_ENDPOINT=HOST:PORT
# MINIO_ACCESS_KEY=USER
# MINIO_SECRET_KEY=PASSWORD
# MINIO_BUCKET=deepface-media
