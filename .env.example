# Local Docker defaults. You can run the project without creating a .env file.
# Copy this file to .env only when you need to override these values.
MYSQL_DATABASE=DB_Employee
MYSQL_PASSWORD=deepface_root_password
TIDB_DATABASE=DB_Employee

# Optional: use TiDB Cloud instead of the local MySQL container.
# TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# TIDB_PORT=4000
# TIDB_USER=your_tidb_user
# TIDB_PASSWORD=your_tidb_password
# TIDB_DATABASE=DB_Employee
# DATABASE_SSL=true
#
# Or set DATABASE_URL directly:
# DATABASE_URL=mysql+pymysql://your_tidb_user:your_tidb_password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/DB_Employee?charset=utf8mb4
# DATABASE_SSL=true

# Local Compose uses the MySQL container by default through docker-compose.yml.
# If MySQL Workbench is connected to a different MySQL server, set DATABASE_URL
# to that exact server. From Docker, a MySQL running on Windows uses host.docker.internal.
# DATABASE_URL=mysql+pymysql://root:deepface_root_password@host.docker.internal:3306/DB_Employee?charset=utf8mb4
DATABASE_SSL=false
REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=deepface-media

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=face_embeddings
VECTOR_SIZE=512
MATCH_THRESHOLD=0.45

GATEWAY_PORT=8080
PUBLIC_API_BASE_URL=http://localhost:8080

# Optional Docker Hub images. Leave empty/default for local build.
# BACKEND_IMAGE=your-dockerhub-user/deepface-backend:latest
# FRONTEND_HOME_IMAGE=your-dockerhub-user/deepface-frontend-home:latest
# FRONTEND_ADMIN_IMAGE=your-dockerhub-user/deepface-frontend-admin:latest
# FRONTEND_USER_IMAGE=your-dockerhub-user/deepface-frontend-user:latest

# Admin auth (protect /api/employees and /api/access-logs).
# ADMIN_AUTH_SECRET=change-me
# ADMIN_TOKEN_TTL_SECONDS=86400

# Cache (multi-layer: L1 in-memory + optional L2 Redis).
# CACHE_REDIS_ENABLED=true
# CACHE_L1_MAX_ENTRIES=512
# CACHE_EMPLOYEES_TTL_SECONDS=10
# CACHE_LOGS_TTL_SECONDS=5
# CACHE_VERIFY_TTL_SECONDS=0

# --- Optional tuning (anti-spoofing + quality gates) ---
# Higher = stricter anti-spoof accept.
# ANTISPOOF_REAL_THRESHOLD=0.75
# FAS_BBOX_PAD_RATIO=0.15
#
# Reject frames that are too dark / too close / face-bright-background-dark.
# QUALITY_MIN_FRAME_BRIGHTNESS=35
# QUALITY_MIN_FACE_BRIGHTNESS=45
# Distance gate defaults are tuned for roughly 40-80cm; calibrate per camera.
# QUALITY_MAX_FACE_AREA_RATIO=0.8
# QUALITY_MIN_FACE_AREA_RATIO=0.047
# QUALITY_MIN_FACE_HEIGHT_RATIO=0.18
# QUALITY_MAX_FACE_HEIGHT_RATIO=0.56
# QUALITY_BRIGHT_FACE_DARK_BG_FACE_MIN=170
# QUALITY_BRIGHT_FACE_DARK_BG_BG_MAX=55
# QUALITY_BRIGHT_FACE_DARK_BG_RATIO_MIN=3.0
# QUALITY_MAX_FACE_ROLL_DEG=25
# QUALITY_MIN_FACE_SHARPNESS=60
# DETECTOR_MIN_SCORE=0.5
# QUALITY_MAX_FACE_YAW_DEG=35
# QUALITY_MAX_FACE_PITCH_DEG=30
# QUALITY_ENFORCE_POSE_GATE=false
